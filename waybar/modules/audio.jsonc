{
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "\uf011",
        "format-icons": {
            "default": [
                "\uf011",
                "\uf00f",
                "\uf010"
            ]
        },
        "on-click": "pavucontrol",
        "tooltip-format": "Output: {volume}%",
        "scroll-step": 5
    },
    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    }
}
